# Copy to .env.local and fill in the values

# FastAPI backend base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Google Gemini API key for AI form generation (server-side only, never exposed to the browser)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-3.8-flash)
GEMINI_MODEL=

# Optional: model tried when the main one is overloaded or unavailable (defaults to gemini-3.6-flash)
GEMINI_FALLBACK_MODEL=
